# PyPI credentials for openwiki-server publishing
# Copy to config/pypi.env and fill in your token.
# config/pypi.env is gitignored — never commit secrets.

OPENWIKI_PYPI_USERNAME=__token__
OPENWIKI_PYPI_TOKEN=replace_with_your_pypi_api_token
OPENWIKI_PYPI_REPOSITORY_URL=https://upload.pypi.org/legacy/
