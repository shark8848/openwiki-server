# openwiki-server Docker 栈环境变量模板
# 用法：cp docker/.env.example .env && docker compose up -d
# 生产必改：HAPROXY_STATS_PASSWORD；启用 LLM 内核时配置 OPENWIKI_SERVER_PROVIDER /
#           OPENWIKI_SERVER_MODEL_ID 与模型凭据（如 OPENAI_API_KEY）。

# ---------- 对外端口（宿主 -> 容器） ----------
OPENWIKI_HTTP_PORT=18011
OPENWIKI_GRPC_PORT=50052
HAPROXY_STATS_PORT=8404

# ---------- HAProxy 代理层 ----------
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=replace-with-strong-stats-password

# ---------- 引擎 ----------
# 关闭 openwiki 内核则强制离线规则切页（无 LLM/网络也全链路可用）
OPENWIKI_SERVER_OPENWIKI=1
OPENWIKI_SERVER_PROVIDER=openai
# OPENWIKI_SERVER_MODEL_ID=
# OPENWIKI_SERVER_UPDATE_TIMEOUT=600
# OPENWIKI_SERVER_LOG_LEVEL=INFO
# OPENWIKI_SERVER_DATA_DIR=/app/data

# ---------- Celery（启用 worker 时：docker compose --profile worker up -d） ----------
# broker/backend 使用外部 redis（compose 不内置 redis 服务）。
# 默认 redis://host.docker.internal:6379/0（宿主 6379，需 Docker 20.10+ host-gateway）；
# 远程实例改成实际地址，如 redis://:password@10.0.0.5:6379/0。
OPENWIKI_SERVER_CELERY_BROKER=redis://host.docker.internal:6379/0
OPENWIKI_SERVER_CELERY_BACKEND=redis://host.docker.internal:6379/0
